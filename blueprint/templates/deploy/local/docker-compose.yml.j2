# Generated by `fastro make deploy local`.
# Hot-reload dev stack: API{% if "worker" in services %} + Taskiq worker{% endif %}{% if "scheduler" in services %} + scheduler{% endif %}{% if "memcached" in services %} + Memcached{% endif %}{% if "rabbitmq" in services %} + RabbitMQ{% endif %} + Postgres + Redis.
# Source is mounted into the container so file changes trigger a reload.

name: {{ project.slug }}

services:
  api:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: dev
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CACHE_REDIS_HOST: redis
      RATE_LIMITER_REDIS_HOST: redis
      TASKIQ_REDIS_HOST: redis
{%- if "memcached" in services %}
      CACHE_MEMCACHED_HOST: memcached
{%- endif %}
{%- if "rabbitmq" in services %}
      TASKIQ_RABBITMQ_HOST: rabbitmq
{%- endif %}
    volumes:
      - ./backend/src:/app/src
      - ./backend/tests:/app/tests
    ports:
      - "{{ params.api_port }}:8000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
{%- if "memcached" in services %}
      memcached:
        condition: service_healthy
{%- endif %}
{%- if "rabbitmq" in services %}
      rabbitmq:
        condition: service_healthy
{%- endif %}
{% if "worker" in services %}
  worker:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: dev
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CACHE_REDIS_HOST: redis
      RATE_LIMITER_REDIS_HOST: redis
      TASKIQ_REDIS_HOST: redis
{%- if "memcached" in services %}
      CACHE_MEMCACHED_HOST: memcached
{%- endif %}
{%- if "rabbitmq" in services %}
      TASKIQ_RABBITMQ_HOST: rabbitmq
{%- endif %}
    working_dir: /app/src
    command: >
      taskiq worker src.infrastructure.taskiq.worker:default_broker
      --reload
    volumes:
      - ./backend/src:/app/src
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
{%- if "memcached" in services %}
      memcached:
        condition: service_healthy
{%- endif %}
{%- if "rabbitmq" in services %}
      rabbitmq:
        condition: service_healthy
{%- endif %}
{% endif %}
{%- if "scheduler" in services %}
  # Run exactly one of these: each scheduler fires every schedule it finds.
  scheduler:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: dev
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CACHE_REDIS_HOST: redis
      RATE_LIMITER_REDIS_HOST: redis
      TASKIQ_REDIS_HOST: redis
{%- if "memcached" in services %}
      CACHE_MEMCACHED_HOST: memcached
{%- endif %}
{%- if "rabbitmq" in services %}
      TASKIQ_RABBITMQ_HOST: rabbitmq
{%- endif %}
    working_dir: /app/src
    command: >
      taskiq scheduler src.infrastructure.taskiq.scheduler:scheduler
    volumes:
      - ./backend/src:/app/src
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
{%- if "memcached" in services %}
      memcached:
        condition: service_healthy
{%- endif %}
{%- if "rabbitmq" in services %}
      rabbitmq:
        condition: service_healthy
{%- endif %}
{% endif %}
{%- if "memcached" in services %}
  memcached:
    image: memcached:1.6-alpine
    ports:
      - "127.0.0.1:11211:11211"
    healthcheck:
      test: ["CMD-SHELL", "echo stats | nc -w 1 127.0.0.1 11211 | grep -q uptime"]
      interval: 5s
      timeout: 3s
      retries: 10
{% endif %}
{%- if "rabbitmq" in services %}
  rabbitmq:
    image: rabbitmq:4-alpine
    hostname: rabbitmq
    env_file:
      - ./backend/.env
    entrypoint:
      - sh
      - -c
      - >-
        RABBITMQ_DEFAULT_USER="$${TASKIQ_RABBITMQ_USER:-guest}"
        RABBITMQ_DEFAULT_PASS="$${TASKIQ_RABBITMQ_PASSWORD:-guest}"
        RABBITMQ_DEFAULT_VHOST="$${TASKIQ_RABBITMQ_VHOST:-/}"
        exec docker-entrypoint.sh rabbitmq-server
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    ports:
      - "127.0.0.1:5672:5672"
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 20s
{% endif %}
  postgres:
    image: postgres:16-alpine
    env_file:
      - ./backend/.env
    volumes:
      - postgres-data:/var/lib/postgresql/data
    ports:
      - "127.0.0.1:5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER:-postgres}\""]
      interval: 5s
      timeout: 3s
      retries: 10

  redis:
    image: redis:7-alpine
    volumes:
      - redis-data:/data
    ports:
      - "127.0.0.1:6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

volumes:
  postgres-data:
  redis-data:
{%- if "rabbitmq" in services %}
  rabbitmq-data:
{%- endif %}
