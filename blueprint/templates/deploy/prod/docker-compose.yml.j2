# Generated by `fastro make deploy prod`.
# Production-ish single-host stack: migration runner + multi-worker API{% if "worker" in services %} + Taskiq worker{% endif %}{% if "scheduler" in services %} + scheduler{% endif %}{% if "memcached" in services %} + Memcached{% endif %}{% if "rabbitmq" in services %} + RabbitMQ{% endif %} + Postgres + Redis.
# The API is exposed directly on the host port: add a reverse proxy (or use
# the `nginx` mode) before public traffic.

name: {{ project.slug }}

services:
  # One-shot, and nothing waits on it: run it and only then restart the rest, so a
  # migration that fails leaves the old code serving on the old schema.
  #     docker compose --profile migrate run --rm migrate
  migrate:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: migrate
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CONFIRM_PRODUCTION_MIGRATION: "yes"
    profiles: ["migrate"]
    depends_on:
      postgres:
        condition: service_healthy
    restart: "no"

  api:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: prod
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CACHE_REDIS_HOST: redis
      RATE_LIMITER_REDIS_HOST: redis
      TASKIQ_REDIS_HOST: redis
{%- if "memcached" in services %}
      CACHE_MEMCACHED_HOST: memcached
{%- endif %}
{%- if "rabbitmq" in services %}
      TASKIQ_RABBITMQ_HOST: rabbitmq
{%- endif %}
      WORKERS: "{{ params.workers }}"
    ports:
      - "{{ params.api_port }}:8000"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
{%- if "memcached" in services %}
      memcached:
        condition: service_healthy
{%- endif %}
{%- if "rabbitmq" in services %}
      rabbitmq:
        condition: service_healthy
{%- endif %}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/ready').read()"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    restart: unless-stopped
{% if "worker" in services %}
  worker:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: prod
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CACHE_REDIS_HOST: redis
      RATE_LIMITER_REDIS_HOST: redis
      TASKIQ_REDIS_HOST: redis
{%- if "memcached" in services %}
      CACHE_MEMCACHED_HOST: memcached
{%- endif %}
{%- if "rabbitmq" in services %}
      TASKIQ_RABBITMQ_HOST: rabbitmq
{%- endif %}
    working_dir: /app/src
    command: taskiq worker src.infrastructure.taskiq.worker:default_broker --workers 2
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
{%- if "memcached" in services %}
      memcached:
        condition: service_healthy
{%- endif %}
{%- if "rabbitmq" in services %}
      rabbitmq:
        condition: service_healthy
{%- endif %}
    restart: unless-stopped
{% endif %}
{%- if "scheduler" in services %}
  # Run exactly one of these: each scheduler fires every schedule it finds.
  scheduler:
    build:
      context: .
      dockerfile: backend/Dockerfile
      target: prod
    env_file:
      - ./backend/.env
    environment:
      POSTGRES_SERVER: postgres
      CACHE_REDIS_HOST: redis
      RATE_LIMITER_REDIS_HOST: redis
      TASKIQ_REDIS_HOST: redis
{%- if "memcached" in services %}
      CACHE_MEMCACHED_HOST: memcached
{%- endif %}
{%- if "rabbitmq" in services %}
      TASKIQ_RABBITMQ_HOST: rabbitmq
{%- endif %}
    working_dir: /app/src
    command: taskiq scheduler src.infrastructure.taskiq.scheduler:scheduler
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
{%- if "memcached" in services %}
      memcached:
        condition: service_healthy
{%- endif %}
{%- if "rabbitmq" in services %}
      rabbitmq:
        condition: service_healthy
{%- endif %}
    restart: unless-stopped
{% endif %}
{%- if "memcached" in services %}
  memcached:
    image: memcached:1.6-alpine
    healthcheck:
      test: ["CMD-SHELL", "echo stats | nc -w 1 127.0.0.1 11211 | grep -q uptime"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped
{% endif %}
{%- if "rabbitmq" in services %}
  rabbitmq:
    image: rabbitmq:4-alpine
    hostname: rabbitmq
    env_file:
      - ./backend/.env
    entrypoint:
      - sh
      - -c
      - >-
        RABBITMQ_DEFAULT_USER="$${TASKIQ_RABBITMQ_USER:-guest}"
        RABBITMQ_DEFAULT_PASS="$${TASKIQ_RABBITMQ_PASSWORD:-guest}"
        RABBITMQ_DEFAULT_VHOST="$${TASKIQ_RABBITMQ_VHOST:-/}"
        exec docker-entrypoint.sh rabbitmq-server
    volumes:
      - rabbitmq-data:/var/lib/rabbitmq
    healthcheck:
      test: ["CMD", "rabbitmq-diagnostics", "-q", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    restart: unless-stopped
{% endif %}
  postgres:
    image: postgres:16-alpine
    env_file:
      - ./backend/.env
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U \"$${POSTGRES_USER:-postgres}\""]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    command: ["redis-server", "--appendonly", "yes"]
    volumes:
      - redis-data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 10
    restart: unless-stopped

volumes:
  postgres-data:
  redis-data:
{%- if "rabbitmq" in services %}
  rabbitmq-data:
{%- endif %}
