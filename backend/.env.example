# ===================================
# Environment Configuration
# ===================================
# Options: production, staging, development, local
ENVIRONMENT=development

# ===================================
# Database Configuration
# ===================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# The compose service name ('postgres' in the generated stack); for local development without
# Docker use 'localhost'
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_ASYNC_PREFIX=postgresql+asyncpg://

# Build the schema from the models as the app boots. Left unset it is on when
# ENVIRONMENT is local or development and off otherwise, which is what you want:
# run 'alembic upgrade head' elsewhere. Setting it to true with
# ENVIRONMENT=production is refused at startup.
# CREATE_TABLES_ON_STARTUP=true

# Hosted / serverless Postgres (Neon, RDS, Cloud SQL, ...): DATABASE_URL overrides
# every POSTGRES_* value above. Mind the asyncpg spelling — the driver prefix is
# postgresql+asyncpg:// and TLS is ssl=require, NOT libpq's sslmode=require.
# Guide: https://benavlabs.github.io/FastAPI-boilerplate/user-guide/database/neon/
# DATABASE_URL=postgresql+asyncpg://user:password@host.example.com/dbname?ssl=require

# Connection pool. POSTGRES_POOL_PRE_PING tests a connection before handing it out,
# so connections dropped by an idle timeout or a suspended serverless compute are
# replaced instead of failing a request. POSTGRES_POOL_RECYCLE discards connections
# older than N seconds (-1 disables); set it below your provider's idle timeout.
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_PRE_PING=true
POSTGRES_POOL_RECYCLE=-1

# ===================================
# Cache Configuration
# ===================================
CACHE_ENABLED=true
# Options: memcached, redis
CACHE_BACKEND=redis

# Client-side cache settings
CLIENT_CACHE_ENABLED=true
CLIENT_CACHE_MAX_AGE=60

# Cache Memcached settings (when using CACHE_BACKEND=memcached)
CACHE_MEMCACHED_HOST=localhost
CACHE_MEMCACHED_PORT=11211
CACHE_MEMCACHED_POOL_SIZE=10
CACHE_MEMCACHED_CONNECT_TIMEOUT=5

# Cache Redis settings (when using CACHE_BACKEND=redis)
# For Docker Compose: use 'redis' (the service name)
# For local development without Docker: use 'localhost'
CACHE_REDIS_HOST=redis
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_CONNECT_TIMEOUT=5
CACHE_REDIS_POOL_SIZE=10

# ===================================
# Rate Limiting Configuration
# ===================================
# Provided by crudauth (Redis-backed). Limits are resolved per request from the
# user's tier and path, falling back to the defaults below.
RATE_LIMITER_ENABLED=true
# redis (default), database or memory. Memory counters are per process, so each worker
# counts a login lockout on its own; database keeps them in two tables of this project's
# database, which every worker shares without a Redis.
RATE_LIMITER_BACKEND=redis
DEFAULT_RATE_LIMIT_LIMIT=100
DEFAULT_RATE_LIMIT_PERIOD=60

# Rate Limiter Redis settings
# Uses DB 1 by default to separate from cache (which uses DB 0)
# For Docker Compose: use 'redis' (the service name)
# For local development without Docker: use 'localhost'
RATE_LIMITER_REDIS_HOST=redis
RATE_LIMITER_REDIS_PORT=6379
RATE_LIMITER_REDIS_DB=1
RATE_LIMITER_REDIS_PASSWORD=
RATE_LIMITER_REDIS_CONNECT_TIMEOUT=5
RATE_LIMITER_REDIS_POOL_SIZE=10

# ===================================
# Email Configuration
# ===================================
# How the account emails (verification, password reset, email change) are delivered.
# 'console' logs each message, link included, and sends nothing: the default, and what
# you want locally. 'smtp' needs EMAIL_SMTP_HOST. With ENVIRONMENT=production the
# startup validator refuses 'console', since it would log working reset links.
EMAIL_BACKEND=console

EMAIL_FROM=no-reply@localhost
EMAIL_FROM_NAME=

# Where the verification, password-reset and email-change links point: your own
# frontend, which reads ?token=... and POSTs it to the matching confirm route.
# Required in production, where an empty or localhost value is refused at startup.
FRONTEND_URL=http://localhost:3000

# Used when EMAIL_BACKEND=smtp. STARTTLS verifies the server's certificate and
# hostname, so a server presenting a self-signed one is refused rather than trusted.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_STARTTLS=true
EMAIL_SMTP_TIMEOUT_SECONDS=10

# ===================================
# Taskiq Configuration
# ===================================
# Broker type: 'redis' or 'rabbitmq'
TASKIQ_BROKER_TYPE=redis

# How many times a task labelled retry_on_error=True runs in all, the first attempt
# included. 0 turns retries off.
TASKIQ_DEFAULT_RETRY_COUNT=3

# Redis broker settings (used when TASKIQ_BROKER_TYPE=redis)
# For Docker Compose: use 'redis' (the service name)
# For local development without Docker: use 'localhost'
TASKIQ_REDIS_HOST=redis
TASKIQ_REDIS_PORT=6379
TASKIQ_REDIS_DB=3
TASKIQ_REDIS_PASSWORD=

# RabbitMQ broker settings (used when TASKIQ_BROKER_TYPE=rabbitmq)
TASKIQ_RABBITMQ_HOST=localhost
TASKIQ_RABBITMQ_PORT=5672
TASKIQ_RABBITMQ_USER=guest
TASKIQ_RABBITMQ_PASSWORD=guest
TASKIQ_RABBITMQ_VHOST=/


# ===================================
# Web Server Configuration
# ===================================
# CORS settings
CORS_ENABLED=true
# Comma-separated list of allowed origins. List your real frontend origins in production:
# CORS_ORIGINS=* lets any site call the API from your users' browsers. The app then drops
# CORS_ALLOW_CREDENTIALS, so a page on another origin can't read a response to a call made with
# the user's cookies - the call still reaches the API. The production validator rejects it.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Compression settings
GZIP_ENABLED=true
GZIP_MINIMUM_SIZE=1000

# API documentation settings
ENABLE_DOCS_IN_PRODUCTION=false
OPENAPI_PREFIX=

# ===================================
# Authentication & Security
# ===================================
SECRET_KEY=insecure-secret-key-change-this-in-production

# Production Security Validation
# Automatically validates security settings in production environments
PRODUCTION_SECURITY_VALIDATION_ENABLED=true

# Session Management
SESSION_TIMEOUT_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=15
MAX_SESSIONS_PER_USER=5
# The most a session may live from sign-in, however active it stays. Unset means the idle
# timeout above is the only one; set it for a periodic re-login (minimum 1).
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12

# The login lockout, counted per address and per account, doubling each round up to the
# ceiling. The window is what decides whether a paced guesser accumulates: crudauth's own
# default counts over 60 seconds, which five tries a minute never trips. The admin panel
# counts on this same policy.
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_BASE_SECONDS=300
LOGIN_LOCKOUT_MAX_SECONDS=3600
SESSION_SECURE_COOKIES=true
# Session storage backend: "redis", "database" or "memory" (memcached is no longer
# supported). "database" keeps sessions in this project's own database, so several
# workers share them with no Redis; it adds the crudauth_store and crudauth_counters
# tables, which need one migration.
SESSION_BACKEND=redis
# Sessions, CSRF tokens, OAuth state and login lockout counters use the cache Redis
# connection (CACHE_REDIS_*) on their own DB, so a cache flush doesn't log everyone out.
SESSION_REDIS_DB=2
# Optional full URL for a dedicated session Redis; overrides the cache connection and SESSION_REDIS_DB.
# SESSION_REDIS_URL=rediss://user:password@sessions-redis.example.com:6380/0

# CSRF Protection
# Set to false for development/testing to disable CSRF validation
CSRF_ENABLED=true

# Number of trusted reverse proxies in front of the app, used to resolve the client
# IP for login lockout. 0 = direct (socket peer); set 1 behind a single nginx/Caddy.
TRUSTED_PROXY_HOPS=0

# Which peers uvicorn accepts X-Forwarded-For and X-Forwarded-Proto from. Read by
# uvicorn, not by the app, and it decides what request.client and the access logs
# say. Name your proxy's address or subnet; a wildcard lets any client claim any
# address. Leave unset when nothing sits in front of the app.
# FORWARDED_ALLOW_IPS=172.31.240.0/24

# Password policy (crudauth applies this to every password-writing path)
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SPECIAL=true

# ===================================
# Admin Interface (SQLAdmin)
# ===================================
# Enable/disable the admin interface
ADMIN_ENABLED=true
# Where the panel is mounted; the admin session cookie is scoped to this path
ADMIN_BASE_URL=/admin

# ===================================
# OAuth Configuration
# ===================================
OAUTH_REDIRECT_BASE_URL=http://localhost:8000

# Google OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth. Set both to wire it up, alongside Google or on its own; the callback to
# register with GitHub is {OAUTH_REDIRECT_BASE_URL}/api/v1/auth/oauth/callback/github.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ===================================
# Logging
# ===================================
LOG_LEVEL=INFO
# Console format: simple | detailed | structured | json. Empty uses the environment's
# own default: detailed in development, structured in staging, json in production.
# The log file always uses its environment's default. Anything else is refused at startup.
LOG_FORMAT=

# ===================================
# Application Settings
# ===================================
DEBUG=false
APP_NAME=FastAPI Boilerplate
APP_DESCRIPTION=Modular FastAPI starter
VERSION=0.1.0

# Identity in the OpenAPI document. Empty means the field is left out, so a new
# project doesn't inherit someone else's contact or licence.
API_CONTACT_NAME=
API_CONTACT_EMAIL=
API_CONTACT_URL=
API_LICENSE_NAME=
# API_LICENSE_IDENTIFIER and API_LICENSE_URL are alternatives; OpenAPI takes one,
# and the identifier wins when both are set.
API_LICENSE_IDENTIFIER=
API_LICENSE_URL=

# API_TITLE, API_DESCRIPTION and API_VERSION override APP_NAME, APP_DESCRIPTION and VERSION in
# the document only. API_SUMMARY and API_TERMS_OF_SERVICE have no APP_* counterpart.
API_TITLE=
API_SUMMARY=
API_DESCRIPTION=
API_VERSION=
API_TERMS_OF_SERVICE=

# API settings (optional overrides)
# API_PREFIX must start with / and must not end with /. It moves every API route,
# the OAuth routes and the no-store cache header with it.
# API_PREFIX=/api
# DOCS_URL=/docs
# REDOC_URL=/redoc

# ===================================
# Initial Setup Configuration
# ===================================
# Admin user settings (for initial setup)
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# ===================================
# Production Security Checklist
# ===================================
# Before deploying to production, ensure:
# 1. Generate strong SECRET_KEY with high entropy
#    Example: python -c "import secrets; print(secrets.token_urlsafe(64))"
# 2. Set unique database passwords (avoid defaults like 'postgres')
# 3. Set Redis passwords for all instances:
#    - CACHE_REDIS_PASSWORD (for cache operations and sessions)
#    - RATE_LIMITER_REDIS_PASSWORD (for rate limiting)
# 4. Use separate Redis instances/databases for different services:
#    - Cache: CACHE_REDIS_DB=0 (default)
#    - Rate Limiter: RATE_LIMITER_REDIS_DB=1 (default)
#    - Sessions: SESSION_REDIS_DB=2 (default)
#    - Taskiq: TASKIQ_REDIS_DB=3 (default)
# 5. Restrict CORS_ORIGINS to specific domains (avoid *)
# 6. Set strong admin credentials (ADMIN_USERNAME, ADMIN_PASSWORD)
# 7. Review session timeout settings for your security requirements
# 8. Set ENVIRONMENT=production to enable security validation
# 9. Configure RabbitMQ with strong credentials (avoid guest/guest)
