# Generated by `bp deploy generate nginx`.
# Drop-in nginx vhost in front of the FastAPI app container.

upstream {{ project_name }}_api {
    server api:8000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 25M;
    server_tokens off;

    # Forwarded headers. X-Forwarded-For and X-Forwarded-Proto are replaced with what
    # nginx saw, dropping whatever the client sent. uvicorn trusts the headers only from
    # the compose network (FORWARDED_ALLOW_IPS); crudauth counts hops from the right
    # through TRUSTED_PROXY_HOPS.
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Long-running endpoints (exports, AI, etc.) want generous timeouts.
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://{{ project_name }}_api;
        proxy_redirect off;
    }
}
